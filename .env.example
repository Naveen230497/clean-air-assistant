# Optional. Without a key the app still works using the built-in rule-based explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback model for 429/503 retries (non-Search calls only; empty = disabled).
# Note: Gemini free-tier quotas are counted per model.
GEMINI_FALLBACK_MODEL=

# Optional contact URL/email for Nominatim and Overpass User-Agent (defaults to repo URL).
CONTACT_EMAIL=

# Optional UTC daily cap for OpenStreetMap Overpass nearby queries (default: 80).
NEARBY_DAILY_CAP=80
